#!/usr/bin/env python3

# Configure the logger before imports so other packages do not override this
# setup.
import os
import shutil


from cobradb.model_processing import process_model
from cobradb.seed import push_model_seed_metabolites, push_model_seed_reactions

os.environ["LIBCHEBIPY_DOWNLOAD_DIR"] = "/chebi"
import logging
import time
from pathlib import Path
import cProfile

from sqlalchemy.orm import close_all_sessions

from cobradb.compartments import load_compartments
from cobradb.component_loading import load_assembly
from cobradb.chebi import ChebiEntity, parse_structures
from cobradb.curated_reactions import load_reactions
from cobradb.models import *
from cobradb import seed, settings, util
from cobradb.rhea import load_rhea
from cobradb.curated_metabolites import load_bigg_ids
from cobradb.model_loading import load_model
from cobradb.version_loading import load_version_date
from cobradb.memote import load_memote_results, run_memote

import argparse


parser = argparse.ArgumentParser()
parser.add_argument(
    "--drop-all",
    help="Empty database and reload data. NOTE: Does not drop types (e.g. enum categories)",
    action="store_true",
)
parser.add_argument(
    "--drop-models", help="Empty model and map data", action="store_true"
)
parser.add_argument("--drop-maps", help="Empty map data", action="store_true")
parser.add_argument("--skip-genomes", help="Skip genome loading", action="store_true")
parser.add_argument("--skip-models", help="Skip model loading", action="store_true")
parser.add_argument(
    "--skip-memote",
    help="Skip memote execution and result loading",
    action="store_true",
)
parser.add_argument("--skip-maps", help="Skip map loading", action="store_true")
parser.add_argument("--skip-rhea", help="Skip RHEA loading", action="store_true")
parser.add_argument(
    "--skip-curated-metabolites",
    help="Skip curated metabolites loading",
    action="store_true",
)
parser.add_argument(
    "--skip-curated-reactions",
    help="Skip curated reactions loading",
    action="store_true",
)
parser.add_argument(
    "--skip-compartments",
    help="Skip loading compartment names",
    action="store_true",
)
parser.add_argument(
    "--skip-seed-metabolites",
    help="Skip loading SEED metabolite annotations",
    action="store_true",
)
parser.add_argument(
    "--skip-seed-reactions",
    help="Skip loading SEED reaction annotations",
    action="store_true",
)
parser.add_argument(
    "--skip-model-processing", help="Skip model file processing", action="store_true"
)
args = parser.parse_args()


def drop_all_tables(engine, enums_to_drop=None):
    """Drops all tables and, optionally, user enums from a postgres database.

    Adapted from: http://www.siafoo.net/snippet/85


    NOTE: To list all the user defined enums, use something like this:

        SELECT DISTINCT t.typname
        FROM pg_catalog.pg_type t
        JOIN pg_catalog.pg_enum e ON t.oid = e.enumtypid;

    """

    from sqlalchemy.sql.expression import text

    table_sql = (
        "SELECT table_name FROM information_schema.tables "
        "WHERE table_schema='public' AND table_name NOT LIKE 'pg_%%'"
    )

    with engine.begin() as conn:
        for table in [name for (name,) in conn.execute(text(table_sql))]:
            conn.execute(text("DROP TABLE %s CASCADE" % table))

    # drop the enum types
    if enums_to_drop is not None:
        with engine.begin() as conn:
            for enum in enums_to_drop:
                conn.execute(text("DROP TYPE IF EXISTS %s CASCADE" % enum))


def main():
    start_time = time.time()
    timings = {}

    # Workaround because setting the environment variable does not seem to change anything.
    chebi_cache_path = Path("/libChEBI")
    chebi_new_cache_path = Path("/chebi/libChEBI")
    chebi_new_cache_path.mkdir(parents=True, exist_ok=True)
    if chebi_cache_path.exists():
        if not chebi_cache_path.is_symlink():
            shutil.rmtree(chebi_cache_path)
            chebi_cache_path.symlink_to(chebi_new_cache_path, target_is_directory=True)
    else:
        chebi_cache_path.symlink_to(chebi_new_cache_path, target_is_directory=True)

    # Make sure all cache files are downloaded
    for i in range(10):
        failed = False
        try:
            # Load a random chebi entity and access all relevant information.
            # Will download all appropriate files for all compounds.
            c = ChebiEntity("CHEBI:27732")
            parse_structures()
            c.get_id()
            c.get_charge()
            c.get_names()
            c.get_incomings()
            c.get_inchi()
            c.get_database_accessions()
            c.get_smiles()
        except:
            failed = True
        if not failed:
            break
        time.sleep(2)  # wait 2 seconds and try again

    if args.drop_all:
        f_start_time = time.time()
        logging.info("Dropping everything from the database")
        drop_all_tables(engine, custom_enums.keys())
        timings["drop_all"] = time.time() - f_start_time

    if args.drop_models and not args.drop_all:
        f_start_time = time.time()
        from sqlalchemy.sql.expression import text

        logging.info("Dropping rows from models")
        with engine.begin() as conn:
            conn.execute(
                text(
                    "DROP TABLE IF EXISTS model, model_reaction, model_compartmentalized_component, model_gene, memote_result, model_count, publication_model CASCADE;"
                )
            )
            conn.execute(text("DELETE FROM reaction WHERE model_id IS NOT NULL;"))
            conn.execute(text("DELETE FROM reaction WHERE model_id IS NOT NULL;"))

        timings["drop_models"] = time.time() - f_start_time

    f_start_time = time.time()
    logging.info("Building the database models")
    Base.metadata.create_all(bind=engine)
    timings["create_all"] = time.time() - f_start_time

    # make the session
    session = Session()

    # load the date
    load_version_date(session)

    # get the models and genomes from the model_genome file
    model_dir = settings.model_directory
    model_genome_path = settings.model_genome
    refseq_dir = settings.refseq_directory
    logging.info("Loading models and genomes using %s" % model_genome_path)
    lines = util.load_tsv(model_genome_path, required_column_num=None)
    models_list = []

    assemblies = {}

    def get_assembly_filenames(assembly_string):
        assembly_ids = [x.strip() for x in assembly_string.split(",")]
        r = []
        for assembly in assembly_ids:
            r.append(assembly)
            if assembly in assemblies:
                continue
            assembly_file = (
                Path(refseq_dir)
                / "ncbi_dataset"
                / "data"
                / assembly
                / "genomic.gbff.gz"
            )
            if assembly_file.is_file():
                assemblies[assembly] = str(assembly_file)
            else:
                print(f"Assembly file not found: {assembly_file}")
                assemblies[assembly] = None
        return r

    chromosomes = {}
    for line in lines:
        if len(line) > 4:
            line = line[:4]
        model_filename, pub_ref_string, assembly_ref_string, genome_ref_string_plus = (
            line
        )
        if assembly_ref_string is None:
            model_assemblies = None
        else:
            model_assemblies = get_assembly_filenames(assembly_ref_string)
        if genome_ref_string_plus is None:
            model_chromosomes = None
        else:
            model_chromosomes = set(
                [x.strip() for x in genome_ref_string_plus.split(",")]
            )
            if not model_assemblies is None:
                for assembly in model_assemblies:
                    if not assembly in chromosomes:
                        chromosomes[assembly] = set()
                    for chr in model_chromosomes:
                        chromosomes[assembly].add(chr)
        if pub_ref_string is None or pub_ref_string.strip() == "None":
            pub_ref = None
        else:
            pub_ref = util.ref_str_to_tuple(pub_ref_string)
        models_list.append(
            {
                "model_filename": model_filename,
                "pub_ref": pub_ref,
                "assemblies": model_assemblies,
                "chromosomes": model_chromosomes,
                "genome_ref": (
                    None
                    if model_assemblies is None
                    else ("ncbi_assembly", model_assemblies[0])
                ),
            }
        )

    if not args.skip_compartments:
        load_compartments(settings.compartment_names, session)
        session.commit()

    if not args.skip_rhea:
        load_rhea(session, settings.rhea)
    if not args.skip_curated_metabolites:
        load_bigg_ids(session, settings.curated_metabolites)
    if not args.skip_curated_reactions:
        load_reactions(session, settings.curated_reactions)

    # load the genome
    genomes_for_models = {}
    if not args.skip_genomes:
        f_start_time = time.time()
        # find the accessions for the genbank files
        logging.info("Finding GenBank files")

        n = len(assemblies)
        for i, (assembly_id, assembly_path) in enumerate(assemblies.items()):
            # if assembly_id != "GCF_000005845.2":
            #     continue

            logging.info(f"Loading assembly {assembly_id} ({i+1} of {n})")
            try:
                load_assembly(
                    assembly_id, assembly_path, chromosomes.get(assembly_id), session
                )
            except AlreadyLoadedError as e:
                logging.info(str(e))
            except Exception as e:
                logging.exception(e)
        session.commit()
        timings["load_assemblies"] = time.time() - f_start_time

    if not args.skip_models:
        f_start_time = time.time()
        logging.info("Loading models")
        n = len(models_list)
        model_dir = Path(settings.model_directory)
        for i, model_dict in enumerate(models_list):
            # if model_dict["model_filename"] not in [
            #     "iML1515.json",
            # ]:
            #     continue
            print(model_dict)
            logging.info(
                "Loading model ({} of {}) {}".format(
                    i + 1, n, model_dict["model_filename"]
                )
            )
            model_bigg_id = None
            already_loaded = False
            try:
                model_bigg_id, model_db_id = load_model(
                    model_dir / model_dict["model_filename"],
                    model_dict["pub_ref"],
                    model_dict["genome_ref"],
                    session,
                )
            except AlreadyLoadedError as e:
                logging.info(str(e))
                model_bigg_id, model_db_id = e.bigg_id, e.db_id
                already_loaded = True
            except Exception as e:
                print(
                    f"model_dir: '{model_dir}', model_path: '{model_dir / model_dict['model_filename']}'"
                )
                logging.error("Could not load model %s." % model_dict["model_filename"])
                logging.exception(e)

        timings["load_models"] = time.time() - f_start_time

    modelseed_db = None
    if not args.skip_seed_metabolites:
        modelseed_dir = "/chebi"
        # seed.download_or_update(modelseed_dir)
        modelseed_db = seed.load_modelseed_database(modelseed_dir)
        push_model_seed_metabolites(modelseed_db, session)
        session.commit()
    if not args.skip_seed_reactions:
        modelseed_dir = "/chebi"
        # seed.download_or_update(modelseed_dir)
        if modelseed_db is None:
            modelseed_db = seed.load_modelseed_database(modelseed_dir)
        push_model_seed_reactions(modelseed_db, session)
        session.commit()

    if not args.skip_model_processing:
        f_start_time = time.time()
        logging.info("Processing models")
        n = len(models_list)
        model_dir = Path(settings.model_directory)
        for i, model_dict in enumerate(models_list):
            # if model_dict["model_filename"] not in [
            #     "iML1515.json",
            # ]:
            #     continue
            print(model_dict)
            logging.info(
                "Processing model ({} of {}) {}".format(
                    i + 1, n, model_dict["model_filename"]
                )
            )
            model_bigg_id = None
            try:
                model_bigg_id, _model_db_id = process_model(
                    session,
                    model_dir / model_dict["model_filename"],
                )
            except Exception as e:
                print(
                    f"model_dir: '{model_dir}', model_path: '{model_dir / model_dict['model_filename']}'"
                )
                logging.error("Could not load model %s." % model_dict["model_filename"])
                logging.exception(e)

            if not args.skip_memote and model_bigg_id is not None:
                model_biggr_filename = f"/models/models/{model_bigg_id}.biggr.sbml"
                memote_result_filename = f"/models/memote/{model_bigg_id}.biggr.json.gz"

                successful_memote_run = False
                try:
                    # if not Path(memote_result_filename).exists():
                    run_memote(model_biggr_filename, memote_result_filename)
                    successful_memote_run = True
                except Exception as e:
                    logging.error("Memote failed to run.")
                    logging.exception(e)

                if successful_memote_run:
                    try:
                        load_memote_results(
                            model_bigg_id,
                            memote_result_filename,
                            session,
                        )
                    except Exception as e:
                        logging.error(
                            "Could not load memote results %s."
                            % model_dict["model_filename"]
                        )
                        logging.exception(e)

        timings["load_models"] = time.time() - f_start_time

    timings["total"] = time.time() - start_time
    logging.debug(str(timings))
    session.close()
    close_all_sessions()


if __name__ == "__main__":
    main()
    # cProfile.run("main()", sort="cumtime")
